    }
  ],
  "narrative": {
    "northStar": "Practical factory workspace",
    "overview": "Assemble Electrix is practical, dense factory software. The dark industrial navy sidebar and teal actions remain, while Overview is a plain working register: real attention alerts first, unequal KPIs second, due orders next, then material conversion and recent operational activity.\n\nThe user explicitly replaced the former showcase dashboard. Overview uses text controls, compact sections, and quantities with clear units; no pictogram icons appear outside its sidebar. Other modules retain their established bordered panels, shadcn controls, and BOM workflows. The company identity uses the supplied AE SVG mark on the shell and statements, with a matching favicon.",
    "keyCharacteristics": [
      "Attention before totals; due work before summaries.",
      "Neutral unequal Overview KPIs emphasize Pending QC and Unbilled amount.",
      "Text-only Overview, compact bordered work surfaces, and tabular quantities.",
      "Explicit component/product units, record mode, and unknown history.",
      "Aligned three-column attention rows with severity markers; Actual-only backup status and outlined header actions."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use teal for actionable controls, links, and production progress; Overview KPI emphasis comes from neutral surface and size, with semantic color only for relevant states.",
        "section": "colors"
      },
      {
        "name": "The Quantity Rule",
        "body": "Use tabular numerals and right alignment for comparable quantities, rates, and charges; name component pieces separately from product pieces.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Separate resting work surfaces with borders and tone; reserve strong elevation for dialogs and restrained elevation for search results.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show real attention alerts before Overview KPIs.",
      "Do keep current module, date, shift, and record mode explicit.",
      "Do put the next valid action beside the record it changes.",
      "Do preserve contained horizontal table scrolling and visible keyboard focus.",
      "Do label demo records on statements and exported workbooks.",
      "Do keep customer billing rates and worker wages visibly separate.",
      "Do leave missing shift, operator, and backup history visibly unknown."
    ],
    "donts": [
      "Don't add icons outside the sidebar on Overview.",
      "Don't restore the promotional sidebar tagline or factory pitch.",
      "Don't use equal colorful KPI cards, decorative revenue charts, or marketing hero layouts on Overview.",
      "Don't imply an initiated backup download proves the file was saved.",
      "Don't conceal validation, shortage, loading, or storage-error feedback."
    ]
  }
