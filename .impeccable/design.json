      "kind": "chip",
      "description": "Plain rectangular due-order status.",
      "html": "<span class=\"ds-overdue\">Overdue</span>",
      "css": ".ds-overdue{display:inline-block;padding:3px 7px;border-radius:4px;font:400 11px Manrope,sans-serif;white-space:nowrap;background:#fbecea;color:#a52d28}"
