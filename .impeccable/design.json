      "css": ".ds-label{display:grid;gap:7px;font:600 12px Manrope,sans-serif;color:var(--foreground,#18343c)}.ds-input{height:40px;min-width:0;border:1px solid var(--border,#dce5e8);border-radius:6px;padding:4px 12px;background:transparent;color:var(--foreground,#18343c);font:400 13px Manrope,sans-serif;box-shadow:0 1px 2px 0 rgb(0 0 0 / .05)}.ds-input:focus-visible{border-color:var(--primary,#087f72);outline:3px solid var(--focus,#55b2a4);outline-offset:3px;}.ds-input::placeholder{color:var(--muted-foreground,#52696f)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Available status",
      "kind": "chip",
      "refersTo": "chip-ok",
      "description": "Text and color convey availability.",
      "html": "<span class=\"ds-chip\">Available</span>",
      "css": ".ds-chip{display:inline-flex;padding:2px 8px;border:1px solid transparent;border-radius:9999px;background:#e6f3ec;color:#256742;font:500 12px/16px Manrope,sans-serif}"
    },
    {
      "name": "Work panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Bordered white operational container.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">The work on your floor</h2><p class=\"ds-panel-description\">4 active orders</p></section>",
      "css": ".ds-panel{background:#fff;border:1px solid var(--border,#dce5e8);border-radius:10px;padding:20px 22px;color:var(--foreground,#18343c)}.ds-panel-title{margin:0;font:700 17px Manrope,sans-serif;letter-spacing:-.02em}.ds-panel-description{margin:5px 0 0;font:400 12px Manrope,sans-serif;color:var(--muted-foreground,#52696f)}"
    },
    {
      "name": "Active module",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current desktop module and active marker.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\">Overview<span class=\"ds-marker\"></span></a></nav>",
      "css": ".ds-nav{background:var(--workshop,#112c34);padding:18px;width:232px}.ds-nav-link{display:flex;align-items:center;gap:12px;padding:10px 12px;min-height:42px;border-radius:7px;color:#fff;background:#234952;text-decoration:none;font:500 13px Manrope,sans-serif}.ds-nav-link:hover{background:#1e3c44}.ds-nav-link:focus-visible{outline:3px solid var(--focus,#55b2a4);outline-offset:3px;}.ds-marker{margin-left:auto;width:6px;height:6px;border-radius:50%;background:#72d0ba}"
    },
    {
      "name": "Overview priority KPI",
      "kind": "card",
      "refersTo": "overview-kpi-priority",
      "description": "Neutral emphasis for Pending QC and Unbilled amount.",
      "html": "<section class=\"ds-kpi\"><h2>Pending QC</h2><strong>800</strong><p>Pieces awaiting final inspection</p><a href=\"#quality\">Inspect</a></section>",
      "css": ".ds-kpi{background:#FFFBEB;border:1px solid #f3dfb9;border-radius:6px;padding:12px;display:flex;flex-direction:column;gap:8px;font-family:Manrope,sans-serif;color:#B45309}.ds-kpi h2{margin:0;font-size:12px;font-weight:600}.ds-kpi strong{font-size:29px;line-height:1.3;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:#B45309}.ds-kpi p{margin:0;font-size:11px;color:var(--muted-foreground,#52696f)}.ds-kpi a{font-size:11px;font-weight:600;color:var(--primary,#087f72);text-decoration:none}.ds-kpi a:hover{text-decoration:underline}.ds-kpi a:focus-visible{outline:3px solid #55b2a4;outline-offset:3px}@media(max-width:800px){.ds-kpi{padding:10px}.ds-kpi strong{font-size:23px}}"
